generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

/// The main user model stores basic account information.
model User {
  id                Int                @id @default(autoincrement())
  firstName         String
  lastName          String
  email             String             @unique
  password          String             // Store hashed & salted password (e.g., using bcrypt)
  verified          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  /// A user can have multiple saved addresses.
  addresses         Address[]

  /// A user’s order history.
  orders            Order[]

  /// Subscriptions saved by the user.
  subscriptions     Subscription[]

  /// Recipes submitted by the user.
  submittedRecipes  SubmittedRecipe[]

  /// Favorite recipes via a join table.
  favoriteRecipes   FavoriteRecipe[]   @relation("UserFavorites")

  /// Email verification records.
  verifications     UserVerification[]

  /// Each user can have one active cart.
  cart              Cart?
}

/// Model to store temporary email verification codes.
model UserVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

/// Model to store one or more addresses associated with a user.
model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String
  country      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Model to store an order summary.
model Order {
  id             Int      @id @default(autoincrement())
  orderNumber    String   @unique
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  date           DateTime @default(now())
  tracking       String?
  shippingStatus String
  total          Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Model to store subscription information.
model Subscription {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  name       String
  bag        Json     // JSON containing a bag of products
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Model for recipes submitted by users.
model SubmittedRecipe {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id])
  name            String
  photo           String?
  description     String?
  preparationTime Int?
  ingredients     String
  cookTime        Int?
  servings        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  /// Users who have favorited this recipe.
  favoritedBy     FavoriteRecipe[]  @relation("RecipeFavorites")
}

/// Join table to relate users to their favorite recipes.
model FavoriteRecipe {
  userId   Int
  recipeId Int
  user     User            @relation("UserFavorites", fields: [userId], references: [id])
  recipe   SubmittedRecipe @relation("RecipeFavorites", fields: [recipeId], references: [id])
  @@id([userId, recipeId])
}

/// Model to store a user's shopping cart.
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique  // Each user can have one active cart.
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// Model to store individual items in a cart.
model CartItem {
  id       Int    @id @default(autoincrement())
  cartId   Int
  cart     Cart   @relation(fields: [cartId], references: [id])
  title    String
  price    Float
  quantity Int
}

/// NEXTAUTH MODELS: Add these if you plan to use NextAuth + Prisma Adapter.

// Tracks which provider accounts (Google, Apple, etc.) or credentials
// an individual user has.
model Account {
  id                 Int    @id @default(autoincrement())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Tracks session info if you’re storing sessions in the DB via NextAuth.
model Session {
  id               Int      @id @default(autoincrement())
  sessionToken     String   @unique
  userId           Int
  expires          DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tracks magic-link or other email-based verification tokens if you use
// NextAuth's email provider or a similar flow that requires token-based
// verification.
model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
