# Local development secrets. This file is gitignored (.gitignore: .env*).
# Production values are set in AWS Amplify and written into .env.production
# by amplify.yml at build time — Amplify console vars do not reach SSR compute.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sending domain. Until sunnyislandpepper.com is verified in Resend,
# onboarding@resend.dev works but ONLY delivers to the account owner's address.
INQUIRY_FROM="Sunny Island Pepper Sauce <hello@sunnyislandpepper.com>"

# Where inquiries land. Single inbox for now; per-buyer routing can split later.
INQUIRY_TO_CONSUMER=info@sunnyislandpepper.com
INQUIRY_TO_WHOLESALE=info@sunnyislandpepper.com
INQUIRY_TO_RETAIL=info@sunnyislandpepper.com
INQUIRY_TO_OTHER=info@sunnyislandpepper.com

# Optional. When set, every lead is written here before any email is sent.
DATABASE_URL=

NEXT_PUBLIC_SITE_URL=https://www.sunnyislandpepper.com
